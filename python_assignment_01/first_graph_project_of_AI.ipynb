   "source": [
    "import matplotlib.pyplot as plt\n",
    "\n",
    "years = [2020, 2021, 2022, 2023, 2024]\n",
    "gold_price = [48651, 48720, 52670, 65330, 77913]\n",
    "\n",
    "plt.plot(years, gold_price, marker='o')\n",
    "\n",
    "plt.title(\"Gold Price in India (Per 10g)\")\n",
    "plt.xlabel(\"Year\")\n",
    "plt.ylabel(\"Price (₹)\")\n",
    "\n",
    "plt.grid(True)\n",
    "\n",
    "plt.show()\n"
   ]
